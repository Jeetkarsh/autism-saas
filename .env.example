# --- WhatsApp (Twilio) Integration ---
# Your Twilio Account SID (find at console.twilio.com)
TWILIO_ACCOUNT_SID=
# Your Twilio Auth Token
TWILIO_AUTH_TOKEN=
# WhatsApp sender number in E.164 format: whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=
# Verify token you set in Twilio sandbox for webhook verification
TWILIO_VERIFY_TOKEN=

# --- Next.js Frontend Configuration ---
# Your Supabase Project URL (e.g., https://your-project.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=
# Your Supabase Anon Key
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- RAG Backend Connection ---
# URL of the knowledge engine backend
RAG_SERVICE_URL=http://localhost:8100
# API key to authenticate with the knowledge engine
RAG_API_KEY=development_secret_key

# --- Twilio WhatsApp Integration ---
# Twilio Account SID (find in Twilio Console)
TWILIO_ACCOUNT_SID=
# Twilio Auth Token
TWILIO_AUTH_TOKEN=
# Twilio WhatsApp sender number (format: whatsapp:+14155238886)
TWILIO_WHATSAPP_FROM=
